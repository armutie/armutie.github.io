# Frontend variables are public and are embedded into the Vite bundle.
# Demo mode must be explicitly enabled. Never place provider secrets here.
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Set these as Supabase Edge Function secrets, not in a frontend .env file.
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
NUTRITION_PROVIDER=usda
USDA_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:4173,https://armutie.github.io
